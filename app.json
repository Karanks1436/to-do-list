{
  "expo": {
    "name": "KS14 ToDo List",
    "slug": "to-do-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "https://i.pinimg.com/736x/5e/81/9a/5e819a5ce865476b73087fd1276e7c3e.jpg",
    "scheme": "todolist",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "https://i.pinimg.com/736x/5e/81/9a/5e819a5ce865476b73087fd1276e7c3e.jpg",
        "backgroundImage": "https://i.pinimg.com/736x/5e/81/9a/5e819a5ce865476b73087fd1276e7c3e.jpg",
        "monochromeImage": "https://i.pinimg.com/736x/5e/81/9a/5e819a5ce865476b73087fd1276e7c3e.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.karanks1436.todolist"
    },
    "web": {
      "output": "static",
      "favicon": "https://i.pinimg.com/736x/5e/81/9a/5e819a5ce865476b73087fd1276e7c3e.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "https://i.pinimg.com/736x/5e/81/9a/5e819a5ce865476b73087fd1276e7c3e.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d54e2e00-246d-40d2-97ec-24f89301e026"
      }
    }
  }
}
