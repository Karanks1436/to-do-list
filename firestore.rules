rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function mine(uid){return signed()&&request.auth.uid==uid;}
  function admin(){return signed()&&request.auth.token.email=='karank2s6266@gmail.com';}
  function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function collector(){return signed()&&me().role=='collector'&&me().status=='active';}
  function small(value){return value is string&&value.size()<955734;}

  match /appConfig/{id}{allow read:if true;allow write:if admin();}
  match /users/{uid}{
   allow create:if mine(uid)&&(
    (request.resource.data.role=='giver'&&request.resource.data.status=='active')||
    (request.resource.data.role=='collector'&&request.resource.data.status=='pending')||
    (admin()&&request.resource.data.role=='admin')
   );
   allow read:if mine(uid)||admin()||(signed()&&resource.data.role=='collector'&&resource.data.status=='active');
   allow update:if admin()||(mine(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly([
    'name','phone','address','photoURL','businessName','ownerName','addressLine','city','state','postalCode','serviceRadiusKm','acceptedMaterials','location','detailsCompleted','locationUpdatedAt','settings','updatedAt'
   ]));
   allow delete:if false;
  }
  match /materials/{id}{allow read:if signed();allow write:if admin();}
  match /currentRates/{id}{allow read:if signed();allow write:if admin();}
  match /monthlyRates/{month}/items/{id}{allow read:if signed();allow write:if admin();}
  match /collectorLocations/{uid}{allow read:if signed();allow create,update:if mine(uid)&&me().role=='collector';allow delete:if mine(uid)||admin();}

  match /pickupRequests/{id}{
   allow create:if signed()&&request.resource.data.giverId==request.auth.uid&&me().role=='giver';
   allow read:if signed()&&(
    resource.data.giverId==request.auth.uid||resource.data.collectorId==request.auth.uid||admin()||
    (collector()&&resource.data.status=='open')
   );
   allow update:if admin()||(
    collector()&&(
     (resource.data.status in ['open','requested']&&(!resource.data.keys().hasAny(['collectorId'])||resource.data.collectorId==null)&&request.resource.data.collectorId==request.auth.uid&&request.resource.data.status=='accepted')||
     (resource.data.collectorId==request.auth.uid&&request.resource.data.collectorId==request.auth.uid&&request.resource.data.status in ['on_the_way','arrived','completed'])
    )
   );
   allow delete:if false;
  }
  match /transactions/{id}{
   allow read:if signed()&&(resource.data.giverId==request.auth.uid||resource.data.collectorId==request.auth.uid||admin());
   allow create:if collector()&&request.resource.data.collectorId==request.auth.uid&&
    getAfter(/databases/$(database)/documents/pickupRequests/$(request.resource.data.pickupId)).data.collectorId==request.auth.uid&&
    getAfter(/databases/$(database)/documents/pickupRequests/$(request.resource.data.pickupId)).data.status=='completed';
   allow update,delete:if false;
  }
  match /notifications/{id}{
   allow read:if signed()&&(resource.data.userId==request.auth.uid||admin());
   allow create:if collector()&&request.resource.data.pickupId is string&&
    getAfter(/databases/$(database)/documents/pickupRequests/$(request.resource.data.pickupId)).data.collectorId==request.auth.uid;
   allow update:if signed()&&resource.data.userId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
   allow delete:if false;
  }
  match /wasteImages/{id}{allow create:if signed()&&request.resource.data.userId==request.auth.uid&&small(request.resource.data.base64);allow read,delete:if signed()&&(resource.data.userId==request.auth.uid||admin());allow update:if false;}
  match /collectorDocuments/{uid}/files/{id}{allow create:if mine(uid)&&small(request.resource.data.base64);allow read:if mine(uid)||admin();allow update,delete:if false;}
 }
}
